// Single-line comment

/*
	Multi-line comment
*/


//// Class

class Point {
	// Fields
	int x
	int y

	// Constructor: reserved word, no return type, one per class
	// Parameters with defaults must come last
	constructor(int x = 0, int y = 0) {
		this.x = x
		this.y = y
	}

	// Method
	int sum() {
		return this.x + this.y
	}
}


//// Function

int add(int a, int b) {
	return a + b
}


//// Entry point

int main() {
	// Variables
	int count = 3
	bool is_ready = true
	char letter = 'a'

	// Assignment
	count = count + 1

	// Operators
	int math = (1 + 2) * 3 - 4 / 2
	bool check = (count >= 3 && count != 10) || !is_ready

	// Strings
	print("plain string\n")
	print(f"formatted string: {count}\n")

	// If / else: braces optional for a single statement
	if (count > 3) print("big\n")
	else if (count == 3) print("three\n")
	else print("small\n")

	// If / else: braces required for multiple statements
	if (is_ready) {
		count = count + 1
		print("ready\n")
	}
	else {
		count = 0
		print("not ready\n")
	}

	// Loop: the only loop. Repeats while the expression is true.
	int i = 0
	loop (i < count) {
		i = i + 1

		// Skip to the next iteration
		if (i == 2) continue

		// Exit the loop
		if (i == 4) break

		print(f"{i}\n")
	}

	// Loop: braces optional for a single statement
	int j = 0
	loop (j < 3) j = j + 1

	// Function call
	int total = add(2, 3)

	// Object creation
	Point origin = new Point()
	Point point = new Point(3, 4)

	// Named arguments: positional first, named after
	Point only_y = new Point(y = 5)

	// Method call
	print(f"{point.sum()}\n")

	return 0
}
